# Copy to .env, then replace the placeholder with a strong unique development secret.
MSSQL_SA_PASSWORD=
MSSQL_PORT=14336

# Persist a new organisation UUID before first bootstrap; never regenerate it for an existing account store.
MATAHR_TENANT_ID=
MATAHR_BOOTSTRAP_EMAIL=
# Account password: 14+ characters, uppercase/lowercase, digit and symbol. Separate from SQL credentials.
MATAHR_BOOTSTRAP_PASSWORD=
# Optional, explicitly reviewed original tenant ID for legacy data. Destination is MATAHR_TENANT_ID.
MATAHR_LEGACY_SOURCE_TENANT_ID=
